# Demo mode: leave secrets empty — Plan → Grant → Execute → Revoke works with simulated adapters.
# Live mode: see README.md "Live prerequisites" and docs/demo-storyboard.md.

# Planner (optional — Venice → Groq → deterministic fallback)
VENICE_API_KEY=
VENICE_MODEL=venice-uncensored-1-2
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Session orchestrator identity (agent smart account — NOT the user's EOA)
# Used for ERC-7710 redelegation signing and as the 1Shot work-transfer recipient in live mode.
NEXT_PUBLIC_SESSION_ACCOUNT=
SESSION_PRIVATE_KEY=

# Live execution toggles (also exposed to the dashboard via next.config env)
X402_LIVE=false
ONE_SHOT_LIVE=false

# 1Shot public relayer (Base mainnet)
ONE_SHOT_RELAYER_URL=https://relayer.1shotapi.com/relayers
ONE_SHOT_WEBHOOK_SECRET=

# ProofRegistry on Base — deploy once: npm run deploy:registry
PROOF_REGISTRY_ADDRESS=
NEXT_PUBLIC_PROOF_REGISTRY_ADDRESS=
ANCHOR_PRIVATE_KEY=
DEPLOYER_PRIVATE_KEY=

# Chain + app URLs
BASE_RPC_URL=https://mainnet.base.org
NEXT_PUBLIC_BASE_EXPLORER=https://basescan.org
NEXT_PUBLIC_APP_URL=http://localhost:3000
